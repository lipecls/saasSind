# ===== Docker (docker compose) =====
# Senha do banco PostgreSQL criado pelo docker compose. Troque!
POSTGRES_PASSWORD=troque-esta-senha
# Porta em que o sistema ficará acessível no servidor (http://IP-DO-SERVIDOR:PORTA)
APP_PORT=3000

# ===== Comum =====
# Chave secreta das sessões (mínimo 32 caracteres). Gere com: openssl rand -base64 32
SESSION_SECRET=troque-esta-chave-por-uma-aleatoria-de-32+caracteres
# true somente se o acesso for por HTTPS (ex.: atrás de um proxy com certificado)
COOKIE_SECURE=false

# ===== Instalação manual (sem Docker) =====
DATABASE_URL="postgresql://sind:sind@localhost:5432/sindicato"
